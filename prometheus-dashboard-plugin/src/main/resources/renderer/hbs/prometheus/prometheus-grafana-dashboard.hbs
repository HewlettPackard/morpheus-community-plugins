<style>
	.prom-dash {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		padding: 20px;
		background: #f5f7fa;
		margin: 0;
	}
	.prom-dash .container {
		max-width: 1200px;
		margin: 0 auto;
		background: white;
		padding: 30px;
		border-radius: 12px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.1);
	}
	.prom-dash .report-header {
		text-align: center;
		margin-bottom: 30px;
		padding-bottom: 20px;
		border-bottom: 3px solid #667eea;
	}
	.prom-dash .report-header h1 {
		margin: 0 0 12px 0;
		font-size: 28px;
		color: #2c3e50;
	}
	.prom-dash .query-info {
		font-family: 'Courier New', monospace;
		background: #f8f9fa;
		padding: 8px 16px;
		border-radius: 6px;
		font-size: 13px;
		color: #495057;
		display: inline-block;
	}
	.prom-dash .stats-panel {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 20px;
		margin-bottom: 30px;
	}
	.prom-dash .stat-card {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		color: white;
		padding: 24px;
		border-radius: 12px;
		text-align: center;
		box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
	}
	.prom-dash .stat-card .label {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		opacity: 0.9;
		margin-bottom: 10px;
		font-weight: 600;
	}
	.prom-dash .stat-card .value {
		font-size: 36px;
		font-weight: bold;
		line-height: 1.2;
		word-break: break-all;
	}
	.prom-dash .stat-card .unit {
		font-size: 14px;
		opacity: 0.85;
		margin-top: 6px;
	}
	.prom-dash .chart-section {
		margin-bottom: 30px;
	}
	.prom-dash .chart-section h2 {
		font-size: 18px;
		color: #2c3e50;
		margin: 0 0 16px 0;
		padding-bottom: 10px;
		border-bottom: 2px solid #e9ecef;
	}
	.prom-dash .badge {
		display: inline-block;
		padding: 3px 10px;
		background: #28a745;
		color: white;
		border-radius: 10px;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		margin-left: 8px;
		vertical-align: middle;
	}
	.prom-dash .timestamp-footer {
		text-align: center;
		color: #6c757d;
		font-size: 13px;
		margin-top: 20px;
		padding-top: 16px;
		border-top: 1px solid #e9ecef;
	}
</style>

<div class="prom-dash">
	<div class="container">
		<div class="report-header">
			<h1>{{metricName}}</h1>
			<div class="query-info">{{query}}</div>
		</div>

		<div class="stats-panel">
			<div class="stat-card">
				<div class="label">Current Value</div>
				<div class="value">{{currentValue}}</div>
				<div class="unit">bytes</div>
			</div>
			<div class="stat-card">
				<div class="label">Data Points</div>
				<div class="value">{{dataPoints}}</div>
				<div class="unit">last hour</div>
			</div>
		</div>

		<div class="chart-section">
			<h2>Network Receive Bytes &mdash; Last Hour <span class="badge">30s interval</span></h2>
			{{{svgChart}}}
		</div>

		<div class="timestamp-footer">Last updated: {{timestamp}}</div>
	</div>
</div>
